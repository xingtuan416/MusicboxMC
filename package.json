{
  "name": "musicboxmc",
  "version": "0.4.6",
  "private": true,
  "description": "MIDI → Minecraft 红石音乐 .litematic 投影生成器",
  "license": "GPL-3.0-only",
  "author": "xingtuan416",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xingtuan416/MusicboxMC.git"
  },
  "bugs": {
    "url": "https://github.com/xingtuan416/MusicboxMC/issues"
  },
  "homepage": "https://github.com/xingtuan416/MusicboxMC#readme",
  "engines": {
    "node": ">=26"
  },
  "main": "dist/src/main/index.js",
  "scripts": {
    "build": "node node_modules/typescript7/bin/tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "electron:install": "node node_modules/electron/install.js",
    "typecheck": "node node_modules/typescript7/bin/tsc -p tsconfig.json --noEmit && node node_modules/typescript7/bin/tsc -p tsconfig.test.json",
    "start": "npm run electron:install && npm run build && electron dist/src/main/index.js",
    "cli": "tsx scripts/cli.ts",
    "resourcepack:check": "node scripts/check-piano-pack.mjs",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "dist": "npm run electron:install && npm run build && electron-builder --win --x64 --publish never",
    "dist:dir": "npm run electron:install && npm run build && electron-builder --win --x64 --dir --publish never",
    "smoke": "node scripts/smoke-ipc.cjs",
    "verify:litematic": "tsx scripts/verify-litematic-java.ts",
    "release:notes": "node scripts/release-notes.mjs",
    "verify:ui": "node scripts/verify-ui.cjs",
    "verify:about": "node scripts/verify-about.cjs"
  },
  "dependencies": {
    "@tonejs/midi": "^2.0.28",
    "midi-file": "^1.2.4"
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-arm64": "^4.68.3",
    "@rollup/rollup-darwin-x64": "^4.68.3",
    "@rollup/rollup-linux-arm64-gnu": "^4.68.3",
    "@rollup/rollup-linux-x64-gnu": "^4.68.3",
    "@rollup/rollup-win32-x64-msvc": "^4.68.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "playwright-core": "^1.65.1",
    "prettier": "^3.10.1",
    "tsx": "^4.19.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.2",
    "typescript7": "npm:typescript@^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "build": {
    "appId": "com.musicboxmc.app",
    "productName": "MusicboxMC",
    "directories": {
      "output": "release"
    },
    "electronDist": "node_modules/electron/dist",
    "disableAsarIntegrity": true,
    "files": [
      "dist/**/*",
      "package.json",
      "!**/*.map"
    ],
    "win": {
      "icon": "assets/icon.png",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "artifactName": "${productName}-${version}-win-${arch}.${ext}",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "${productName}-Setup-${version}-win-${arch}.${ext}"
    }
  }
}
