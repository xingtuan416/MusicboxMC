{
  "name": "musicboxmc",
  "version": "0.1.0",
  "private": true,
  "description": "MIDI → Minecraft 红石音乐 .litematic 投影生成器",
  "license": "GPL-3.0-or-later",
  "author": "xingtuan416",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xingtuan416/MusicboxMC.git"
  },
  "bugs": {
    "url": "https://github.com/xingtuan416/MusicboxMC/issues"
  },
  "homepage": "https://github.com/xingtuan416/MusicboxMC#readme",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/src/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "start": "npm run build && electron dist/src/main/index.js",
    "cli": "tsx scripts/cli.ts",
    "resourcepack:check": "node scripts/check-piano-pack.mjs",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dist": "npm run build && electron-builder --win --x64",
    "dist:dir": "npm run build && electron-builder --win --x64 --dir"
  },
  "dependencies": {
    "@tonejs/midi": "^2.0.28"
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-arm64": "4.64.0",
    "@rollup/rollup-darwin-x64": "4.64.0",
    "@rollup/rollup-linux-arm64-gnu": "4.64.0",
    "@rollup/rollup-linux-x64-gnu": "4.64.0",
    "@rollup/rollup-win32-x64-msvc": "4.64.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "electron": "^33.3.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^2.1.8"
  },
  "build": {
    "appId": "com.musicboxmc.app",
    "productName": "MusicboxMC",
    "directories": {
      "output": "release"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "dist/**/*",
      "package.json",
      "!**/*.map"
    ],
    "win": {
      "icon": "icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "artifactName": "${productName}-${version}-win-${arch}.${ext}",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "${productName}-Setup-${version}-win-${arch}.${ext}"
    }
  }
}
